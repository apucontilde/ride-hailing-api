SERVER_PORT=8080

DB_HOST=localhost
DB_PORT=5432
DB_USER=ridehail
DB_PASSWORD=ridehail_pass
DB_NAME=ridehailing
DB_SSLMODE=disable

REDIS_HOST=localhost
REDIS_PORT=6379

JWT_SECRET=change-me-to-a-random-256-bit-key
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=720h

# Rate limiting
RATE_LIMIT_LOGIN=20
RATE_LIMIT_REGISTER=5
RATE_LIMIT_RIDE_CREATE=10
RATE_LIMIT_GENERAL=100
RATE_LIMIT_WINDOW=60s

# DEM elevation file path (for elevation-aware routing)
DEM_FILE_PATH=

# Routing (api_plans [routing])
# ROUTING_ENGINE=native|pgrouting. `native` (the in-process A* engine) is the
# intentional PERMANENT default — decided, not pending a benchmark gate. The
# measured numbers live in api_plans/STATUS.md ([routing] decision on bug #1);
# they are hardware- and workset-specific, so they are not repeated here.
# `pgrouting` is an opt-in for parity/validation work and the fallback target
# when the extension is absent.
ROUTING_ENGINE=native
# Max distance (m) a pin may snap to a road vertex to count as covered. Beyond it
# the route endpoints answer 200 with is_estimate=true and a straight-line
# polyline, instead of snapping to a road tens of km away. Default 50000 (50 km,
# same scale as PLACES_MAX_RADIUS_M). Set to 0 to disable the check entirely and
# always snap, whatever the distance.
ROUTING_SNAP_RADIUS_M=50000

# Elevation-aware routing for the native engine (api_plans/[elevation]).
# Off by default: ROUTING_ELEVATION=on enables it, the rest are proposals until
# the calibration stage lands. A typo in ROUTING_ELEVATION fails closed (off).
ROUTING_ELEVATION=off
ROUTING_ASCENT_WEIGHT=1.5
ROUTING_DESCENT_WEIGHT=0.3
ROUTING_MAX_GRADE=0.15
ROUTING_ELEV_DEADBAND_M=3.0
ROUTING_ELEV_MIN_COVERAGE=0.99

# Places (OSM POI search) seeding
PLACES_SEED_ON_START=true
PLACES_GEOJSON_PATH=data/places.geojson
PLACES_MAX_RADIUS_M=50000
PLACES_DEFAULT_LIMIT=10
